{
  "openapi": "3.0.0",
  "info": {
    "version": "0.1.0",
    "title": "LumenBazaar Backend API"
  },
  "servers": [
    {
      "url": "https://api.lumenbazaar.example",
      "description": "Production"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Service health status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "operationId": "getVersion",
        "tags": ["Info"],
        "responses": {
          "200": {
            "description": "Version information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Service readiness",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/v1/networks": {
      "get": {
        "operationId": "getNetworks",
        "tags": ["Discovery"],
        "responses": {
          "200": {
            "description": "Supported networks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetworksResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/supported": {
      "get": {
        "operationId": "getSupported",
        "tags": ["Payment"],
        "responses": {
          "200": {
            "description": "Supported payment schemes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupportedPaymentSchemes"
                }
              }
            }
          }
        }
      }
    },
    "/v1/resources": {
      "get": {
        "operationId": "listResources",
        "tags": ["Resources"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourcesPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createResource",
        "tags": ["Resources"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateResourceInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resource created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          }
        }
      }
    },
    "/v1/resources/{resourceId}": {
      "get": {
        "operationId": "getResource",
        "tags": ["Resources"],
        "parameters": [
          {
            "name": "resourceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/v1/sellers": {
      "post": {
        "operationId": "createSeller",
        "tags": ["Sellers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSellerInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Seller created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Seller"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sellers/{sellerId}/verify-domain": {
      "post": {
        "operationId": "verifyDomain",
        "tags": ["Sellers"],
        "parameters": [
          {
            "name": "sellerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": ["well-known", "dns"]
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyDomainResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/discovery/search": {
      "get": {
        "operationId": "searchResources",
        "tags": ["Discovery"],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/discovery/validate": {
      "post": {
        "operationId": "validateResource",
        "tags": ["Discovery"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceValidationResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/verify": {
      "post": {
        "operationId": "verifyPayment",
        "tags": ["Payment"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment verification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentVerification"
                }
              }
            }
          }
        }
      }
    },
    "/v1/settle": {
      "post": {
        "operationId": "settlePayment",
        "tags": ["Payment"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settlement result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settlement"
                }
              }
            }
          }
        }
      }
    },
    "/v1/receipts/{receiptId}": {
      "get": {
        "operationId": "getReceipt",
        "tags": ["Receipts"],
        "parameters": [
          {
            "name": "receiptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          }
        }
      }
    },
    "/v1/conformance/runs": {
      "get": {
        "operationId": "listConformanceRuns",
        "tags": ["Conformance"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conformance runs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConformanceRun"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          }
        },
        "required": ["app", "ok", "service"]
      },
      "Version": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          }
        },
        "required": ["service", "version", "environment"]
      },
      "ReadinessCheck": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ready", "unavailable", "not_required"]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": ["status"]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "environment": {
            "type": "string"
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "exact": {
                "type": "boolean"
              },
              "upto": {
                "type": "boolean"
              }
            },
            "required": ["exact", "upto"]
          },
          "checks": {
            "type": "object"
          }
        },
        "required": ["ok", "environment", "capabilities", "checks"]
      },
      "NetworksResponse": {
        "type": "object",
        "properties": {
          "networks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "passphrase": {
                  "type": "string"
                },
                "horizonUrl": {
                  "type": "string"
                },
                "rpcUrl": {
                  "type": "string"
                },
                "assets": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "required": ["networks"]
      },
      "SupportedPaymentSchemes": {
        "type": "object",
        "properties": {
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string",
                  "enum": ["exact", "upto"]
                },
                "network": {
                  "type": "string"
                },
                "x402Version": {
                  "type": "integer"
                }
              }
            }
          },
          "signers": {
            "type": "object"
          }
        },
        "required": ["extensions", "kinds", "signers"]
      },
      "Resource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["http", "mcp"]
          },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "inactive"]
          }
        },
        "required": ["id", "name", "type", "status"]
      },
      "ResourcesPage": {
        "type": "object",
        "properties": {
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resource"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["resources", "nextCursor"]
      },
      "CreateResourceInput": {
        "type": "object",
        "properties": {
          "sellerId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["sellerId", "name"]
      },
      "Seller": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "walletAddress": {
            "type": "string"
          }
        },
        "required": ["id", "domain", "walletAddress"]
      },
      "CreateSellerInput": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "walletAddress": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": ["domain", "walletAddress", "displayName"]
      },
      "VerifyDomainResult": {
        "type": "object",
        "properties": {
          "sellerId": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": ["sellerId", "domain", "verified"]
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resource"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "partialResults": {
            "type": "boolean"
          },
          "ranking": {
            "type": "object"
          }
        },
        "required": ["resources", "nextCursor", "partialResults", "ranking"]
      },
      "PaymentVerification": {
        "type": "object",
        "properties": {
          "isValid": {
            "type": "boolean"
          }
        },
        "required": ["isValid"]
      },
      "Settlement": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "transaction": {
            "type": "string"
          }
        },
        "required": ["success", "transaction"]
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "finalized", "failed"]
          }
        },
        "required": ["id", "status"]
      },
      "ConformanceRun": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": ["id", "status"]
      },
      "ResourceValidationResult": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": ["valid", "errors", "warnings"]
      }
    }
  }
}
