{
  "name": "lumenbazaar-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm test:e2e:smoke && pnpm test:e2e:release",
    "test:e2e:a11y": "playwright test --config playwright.config.ts tests/e2e/a11y.spec.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:prod-connectivity": "playwright test --config playwright.prod-connectivity.config.ts",
    "test:e2e:release": "playwright test --config playwright.release.config.ts",
    "test:e2e:release-screenshots": "playwright test --config playwright.release.config.ts tests/release-e2e/screenshots.spec.ts",
    "test:e2e:smoke": "playwright test",
    "screenshots:generate": "pnpm test:e2e:release-screenshots",
    "screenshots:organize": "node scripts/screenshot-release-artifacts.mjs",
    "screenshots:release": "pnpm test:e2e:release-screenshots && pnpm screenshots:organize",
    "test:watch": "vitest",
    "audit:prod": "node scripts/audit-production.mjs",
    "check:docs-links": "node scripts/check-docs-links.mjs",
    "verify-backend-pin": "node scripts/verify-backend-pin.mjs",
    "update-backend-pin": "node scripts/update-backend-pin.mjs",
    "generate-client": "node scripts/update-backend-pin.mjs",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.7.1",
    "@stellar/freighter-api": "6.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@x402/core": "2.28.0",
    "@x402/stellar": "2.28.0",
    "clsx": "2.1.1",
    "lucide-react": "1.39.0",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.4.2",
    "prettier": "3.8.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@stellar/stellar-sdk": "17.2.1",
      "axios": "1.20.0",
      "sharp": "0.35.5",
      "smol-toml": "1.9.0",
      "source-map-js": "1.2.2"
    }
  }
}
